---
import { SITE_URL, CONTACT, ANALYTICS } from '../data/site';
import neighborhoods from '../data/neighborhoods.json';

interface Props {
  /** URL absoluta da imagem — mesma do og:image, para não divergirem */
  image?: string;
}
const { image } = Astro.props;

// Schema LocalBusiness — antes duplicado em cada página HTML, agora gerado.
//
// NÃO TEM `aggregateRating`, de propósito, e não é por causa do número errado. O
// Review snippet do Google diz, textualmente: "If the entity that's being reviewed
// controls the reviews about itself, their pages that use LocalBusiness or any other
// type of Organization structured data are ineligible for star review feature." E, na
// mesma página: "Don't aggregate reviews or ratings from other websites."
//
// Ou seja: esta página NUNCA foi elegível à estrela no resultado de busca — nem com
// 4,8/127, nem com 5,0/15, nem com o 4,6/19 conferido. O comentário que vivia aqui
// dizia que divergir do perfil "custa o rich result inteiro"; custava um rich result
// que não estava disponível. Emitir a nota só criava uma afirmação a mais para manter
// sincronizada, sem nada em troca.
//
// A estrela que o visitante vê no pacote local e no painel de conhecimento vem do
// Google Business Profile, não deste markup. Para mudá-la, mexe-se no perfil.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Verly Vidraçaria',
  image: image ?? `${SITE_URL}/img/logo.png`,
  description:
    'Especialista em vidros temperados, box blindex, cortinas de vidro e soluções em alumínio na Zona Oeste do Rio de Janeiro. Atendimento rápido, qualidade garantida e equipe especializada.',
  '@id': SITE_URL,
  url: SITE_URL,
  telephone: `+${CONTACT.mobile}`,
  email: CONTACT.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.address.street,
    addressLocality: CONTACT.address.locality,
    addressRegion: CONTACT.address.region,
    postalCode: CONTACT.address.postalCode,
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: CONTACT.address.lat,
    longitude: CONTACT.address.lng,
  },
  areaServed: [
    {
      '@type': 'City',
      name: 'Rio de Janeiro',
      containsPlace: neighborhoods.map((n) => ({ '@type': 'Neighborhood', name: n.name })),
    },
  ],
  priceRange: '$$',
  // As faixas são as do Perfil da Empresa no Google, conferidas no painel em 18/09/2026.
  // Structured data que discorda do perfil é a pior das duas: o perfil é quem decide o
  // "aberto agora" na Pesquisa, e aqui a divergência só serve para o Google achar sinal
  // conflitante sobre o mesmo negócio. Sábado fecha ao MEIO-DIA.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '12:00',
    },
  ],
  sameAs: ['https://facebook.com/verlyvidracaria', 'https://instagram.com/verlyvidracaria'],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
