---
import { SITE_URL, CONTACT, ANALYTICS } from '../data/site';
import neighborhoods from '../data/neighborhoods.json';

interface Props {
  /** paridade com o site atual: realengo.html não tem aggregateRating hoje */
  includeRating?: boolean;
}
const { includeRating = true } = Astro.props;

// Schema LocalBusiness — antes duplicado em cada página HTML, agora gerado.
// NOTA: aggregateRating 4.8 / 127 é carregado VERBATIM do site atual por decisão
// explícita (2026-08-07). O número não corresponde ao Google Business Profile e
// segue como item de risco em aberto — structured data inflado pode custar o
// rich result. Trocar quando as avaliações reais entrarem (Fase 3).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Verly Vidraçaria',
  image: `${SITE_URL}/img/logo.png`,
  description:
    'Especialista em vidros temperados, box blindex, cortinas de vidro e soluções em alumínio na Zona Oeste do Rio de Janeiro. Atendimento rápido, qualidade garantida e equipe especializada.',
  '@id': SITE_URL,
  url: SITE_URL,
  telephone: `+${CONTACT.mobile}`,
  email: CONTACT.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.address.street,
    addressLocality: CONTACT.address.locality,
    addressRegion: CONTACT.address.region,
    postalCode: CONTACT.address.postalCode,
    addressCountry: 'BR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: CONTACT.address.lat,
    longitude: CONTACT.address.lng,
  },
  areaServed: [
    {
      '@type': 'City',
      name: 'Rio de Janeiro',
      containsPlace: neighborhoods.map((n) => ({ '@type': 'Neighborhood', name: n.name })),
    },
  ],
  priceRange: '$$',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '08:00',
      closes: '18:00',
    },
  ],
  sameAs: ['https://facebook.com/verlyvidracaria', 'https://instagram.com/verlyvidracaria'],
  ...(includeRating
    ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.8', reviewCount: '127' } }
    : {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
