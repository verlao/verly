---
import Icon from '../components/Icon.astro';
import { CONTACT, NEIGHBORHOOD_OPTIONS } from '../data/site';

interface Props {
  /** Bairro da página — pré-seleciona a opção no <select>. A escolha segue editável:
      quem está na página do Recreio pode morar em Vargem Grande. */
  neighborhood?: string;
  title?: string;
  subtitle?: string;
}
const {
  neighborhood,
  title = 'Solicite Seu Orçamento Gratuito',
  subtitle = 'Preencha o formulário e entraremos em contato em até 2 horas úteis',
} = Astro.props;
---

<section id="contato" class="section contact-section">
        <div class="container">
            <h2 class="section-title">{title}</h2>
            <p class="section-subtitle">
                {subtitle}
            </p>
            <div class="contact-wrapper">
                <!-- Contact Info -->
                <div class="contact-info">
                    <h3>Informações de Contato</h3>

                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <Icon name="whatsapp" />
                        </div>
                        <div class="contact-item-content">
                            <strong>WhatsApp</strong>
                            <p>{CONTACT.mobileDisplay}</p>
                        </div>
                    </div>
                    {/* Os dois campos mostravam o MESMO celular, os dois escritos à mão aqui:
                        quem preferia ligar de um fixo tinha só um número de celular na tela,
                        e o fixo da loja — que o rodapé já publica — não aparecia. Vindo de
                        CONTACT não há como um número mudar e o outro ficar para trás. */}
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <Icon name="phone" />
                        </div>
                        <div class="contact-item-content">
                            <strong>Telefone</strong>
                            <p>{CONTACT.landlineDisplay}</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <Icon name="clock" />
                        </div>
                        <div class="contact-item-content">
                            <strong>Horário de Atendimento</strong>
                            <p>Segunda a Sábado: 8h às 18h</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <Icon name="map-marker-alt" />
                        </div>
                        <div class="contact-item-content">
                            <strong>Área de Atendimento</strong>
                            <p>Toda Zona Oeste do Rio de Janeiro</p>
                            <p style="font-size: 0.875rem; margin-top: 0.5rem; opacity: 0.9;">
                                Barra da Tijuca, Recreio, Jacarepaguá, Campo Grande, 
                                Realengo, Vargem Grande, Pechincha e região
                            </p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <Icon name="award" />
                        </div>
                        <div class="contact-item-content">
                            {/* "Mais de 127 projetos realizados" saiu daqui: o 127 era a
                                contagem falsa de avaliações reciclada como contagem de obras,
                                e não existe registro que a sustente. O que sustenta a garantia
                                é o que dá para conferir — a loja tem endereço, fachada e uma
                                década de porta aberta. */}
                            <strong>Garantia de Qualidade</strong>
                            <p>Mais de 10 anos de experiência, com loja física em Realengo</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form">
                    <div id="formAlert"></div>
                    <form id="contactForm" novalidate>
                        <div class="form-group">
                            <label class="form-label" for="name">
                                Nome Completo <span class="required">*</span>
                            </label>
                            <input 
                                type="text" 
                                id="name" 
                                name="name"
                                class="form-control" 
                                placeholder="Digite seu nome completo"
                                required
                                autocomplete="name"
                            >
                            <div class="form-error" id="nameError"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="phone">
                                Telefone/WhatsApp <span class="required">*</span>
                            </label>
                            <input 
                                type="tel" 
                                id="phone" 
                                name="phone"
                                class="form-control" 
                                placeholder="(21) 9XXXX-XXXX"
                                required
                                autocomplete="tel"
                            >
                            <div class="form-error" id="phoneError"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="email">
                                E-mail
                            </label>
                            <input 
                                type="email" 
                                id="email" 
                                name="email"
                                class="form-control" 
                                placeholder="seu@email.com"
                                autocomplete="email"
                            >
                            <div class="form-error" id="emailError"></div>
                            <div class="form-help">Opcional, mas nos ajuda a enviar o orçamento</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="neighborhood">
                                Seu Bairro <span class="required">*</span>
                            </label>
                            <select 
                                id="neighborhood" 
                                name="neighborhood"
                                class="form-control"
                                required
                            >
                                <option value="">Selecione seu bairro</option>
                                {NEIGHBORHOOD_OPTIONS.map((o) => (
                                  <option value={o} selected={o === neighborhood}>{o}</option>
                                ))}
                            </select>
                            <div class="form-error" id="neighborhoodError"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Serviços de Interesse <span class="required">*</span>
                            </label>
                            <div class="checkbox-group">
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service1" name="services" value="Box para Banheiro">
                                    <label for="service1">Box para Banheiro</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service2" name="services" value="Sacada Envidraçada">
                                    <label for="service2">Sacada Envidraçada</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service3" name="services" value="Guarda-corpo">
                                    <label for="service3">Guarda-corpo</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service4" name="services" value="Portas de Vidro">
                                    <label for="service4">Portas de Vidro</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service5" name="services" value="Janelas de Alumínio">
                                    <label for="service5">Janelas de Alumínio</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service6" name="services" value="Espelhos">
                                    <label for="service6">Espelhos</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service7" name="services" value="Divisórias">
                                    <label for="service7">Divisórias</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service8" name="services" value="Tampos de Mesa">
                                    <label for="service8">Tampos de Mesa</label>
                                </div>
                            </div>
                            <div class="form-error" id="servicesError"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="message">
                                Descreva Seu Projeto (Opcional)
                            </label>
                            <textarea 
                                id="message" 
                                name="message"
                                class="form-control" 
                                rows="4"
                                placeholder="Ex: Preciso de um box de 1,20m x 1,80m para banheiro. Gostaria de receber orçamento."
                            ></textarea>
                            <div class="form-help">Quanto mais detalhes, melhor será nosso orçamento</div>
                        </div>

                        {/* Cor de CTA, não azul de marca: o botão que fecha a conversão é o
                            único que precisava do âmbar e era o único que não usava. */}
                        <button type="submit" class="btn btn-success" id="submitBtn" style="width: 100%;">
                            <span id="btnText">
                                <Icon name="paper-plane" /> Solicitar Orçamento Grátis
                            </span>
                        </button>

                        <p style="text-align: center; margin-top: 1rem; font-size: 0.875rem; color: var(--gray);">
                            <Icon name="clock" /> Responderemos em até 2 horas úteis
                        </p>

                        <p class="form-privacy">
                            <Icon name="shield-alt" /> Usamos seu nome, telefone e bairro apenas para
                            responder este pedido de orçamento.
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </section>
