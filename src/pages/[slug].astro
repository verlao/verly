---
import Compromissos from '../components/Compromissos.astro';
import { compromissos } from '../data/compromissos';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import {
  CONTACT,
  SITE_URL,
  GOOGLE_REVIEWS,
  serviceForLocalLabel,
} from '../data/site';
import QuoteForm from '../components/QuoteForm.astro';
import { provaSocialGoogle } from '../data/google-reviews';
import { idadeRelativa } from '../data/published-reviews';
import { Image } from 'astro:assets';
import lojaFrente from '../assets/loja-verly-realengo.png';
import neighborhoods from '../data/neighborhoods.json';

// As 11 páginas de bairro saem daqui. Antes eram 11 arquivos de ~305 linhas com o
// mesmo esqueleto — e foi por isso que o nav divergiu do index e as âncoras quebraram.
export function getStaticPaths() {
  return neighborhoods.map((n) => ({ params: { slug: n.slug }, props: { n } }));
}

const { n } = Astro.props;
const google = n.slug === 'realengo' ? provaSocialGoogle(idadeRelativa, new Date()) : null;

// O texto local é copy; o slug canônico vem da taxonomia única de site.ts.
const localServices = n.services.map((label: string) => {
  const service = serviceForLocalLabel(label);
  if (!service) {
    throw new Error(`Serviço local sem taxonomia: "${label}" (${n.slug}).`);
  }
  return { label, service };
});

// Condições ainda não confirmadas não entram no FAQ nem no JSON-LD.
const faq = n.slug === 'realengo'
  ? n.faq.filter((f) => !/prazo|pagamento/i.test(f.q))
  : n.faq;

// FAQPage só entra quando o bairro realmente tem perguntas (hoje só Realengo).
const faqSchema =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<Base
  title={n.title}
  description={n.slug === 'realengo' ? 'Verly Vidraçaria em Realengo. Loja física, vidros temperados e orçamento grátis pelo WhatsApp.' : n.metaDescription}
  canonicalPath={`/${n.slug}`}
  ogTitle={n.ogTitle}
  ogDescription={n.ogDescription}
  keywords={n.keywords ?? undefined}
  robots={n.robots ?? undefined}
  ogImage={n.ogImage ?? undefined}
  pageType="bairro"
  neighborhoodPage={n.name}
  hasForm={true}
  hasServices={true}
  hasDifferentials={true}
>
  {faqSchema && (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <section class:list={["hero", { "hero-principal": n.slug === "realengo" }]}>
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <Icon name="map-marker-alt" /> Atendemos {n.name} e toda a Zona Oeste
        </div>
        {/* palavra-chave primeiro, métrica depois — o index já usa essa fórmula.
            O travessão era um separador que só o olho enxergava: em blocos, a
            métrica ganha o peso visual e o h1 fecha em duas linhas. */}
        <h1 class="hero-h1">
          <span class="hero-h1-lead">{n.h1}</span>
          <span class="hero-h1-metric">Orçamento grátis pelo WhatsApp</span>
        </h1>
        {n.heroSubtitle && <p class="hero-subtitle">{n.heroSubtitle}</p>}
        <div class="hero-cta">
          {n.slug !== 'realengo' && (
            <a href="#contato" class="btn btn-success btn-lg">
              <Icon name="clipboard-check" /> Solicitar Orçamento Grátis
            </a>
          )}
          <a href={CONTACT.whatsappDirect} target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg" data-context="hero-whatsapp">
            <Icon name="whatsapp" /> WhatsApp Direto
          </a>
          {n.slug === 'realengo' && (
            <>
              <a href={`tel:${CONTACT.landline}`} class="btn hero-call">
                <Icon name="phone" /> Ligar
              </a>
              <a href="#contato" class="hero-callback">Prefere que a gente ligue? Deixe seu número</a>
            </>
          )}
        </div>
        <div class="trust-badges">
          <div class="trust-badge"><div class="trust-badge-text">Loja física em Realengo</div></div>
          <div class="trust-badge"><div class="trust-badge-text">Orçamento grátis</div></div>
          {compromissos.prazoRespostaHorasUteis != null && <div class="trust-badge"><div class="trust-badge-text">Resposta em até {compromissos.prazoRespostaHorasUteis} horas úteis</div></div>}
          <div class="trust-badge">
            <div class="trust-badge-icon"><Icon name="star" /></div>
            <div class="trust-badge-text">
              <a href={GOOGLE_REVIEWS.profileUrl} target="_blank" rel="noopener noreferrer" data-review-intent="proof" data-review-location="nota-da-pagina-de-bairro">
                {google?.notaExibida ?? GOOGLE_REVIEWS.ratingDisplay}★ no Google
              </a>
            </div>
          </div>
        </div>
      </div>

      <figure class="hero-photo">
        <Image
          src={lojaFrente}
          alt={`Fachada da Verly Vidraçaria em Realengo, que atende ${n.name}`}
          widths={[420, 700, 980]}
          width={980}
          sizes="(max-width: 1024px) 92vw, 460px"
          format="webp"
          quality={80}
          loading="eager"
        />
      </figure>
    </div>
  </section>

  {/* id local: o nav ancorava "Serviços" em /index.html#servicos mesmo aqui, onde a
      seção existe — 3 dos 4 itens do menu levavam o visitante embora da página de
      bairro em que ele acabou de chegar por busca local. */}
  <section id="servicos" class="section">
    <div class="container">
      <h2 class="section-title">{n.sectionTitle}</h2>
      {n.intro.map((p) => <p class="section-subtitle">{p}</p>)}

      <div class="services-grid">
        {localServices.map(({ label, service }) => (
          <div class="service-card" data-service={service.slug} data-whatsapp-message={service.whatsappMessage}>
            <div class="service-icon"><Icon name="check" /></div>
            <h3>{label}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuoteForm
    neighborhood={n.name}
    title={`Orçamento Grátis em ${n.name}`}
    subtitle="Orçamento grátis, sem compromisso. Fale com a loja pelo WhatsApp."
  />

  {n.slug === 'realengo' ? <Compromissos /> : (
  <section id="diferenciais" class="section why-choose">
    <div class="container">
      <h2 class="section-title">Por que escolher a Verly em {n.name}?</h2>
      <div class="services-grid">
        {['Loja física em Realengo', 'Orçamento grátis', 'Contato pelo WhatsApp'].map((r) => (
          <div class="service-card">
            <div class="service-icon"><Icon name="star" /></div>
            <h3>{r}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  )}

  {faq.length > 0 && (
    <section id="faq" class="section">
      <div class="container">
        <h2 class="section-title">Perguntas Frequentes sobre Vidraçaria em {n.name}</h2>
        {/* <details> nativo: o accordion antigo dependia de jQuery + Bootstrap, que saíram */}
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</Base>
