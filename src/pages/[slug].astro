---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import {
  CONTACT,
  GOOGLE_REVIEWS,
  serviceForLocalLabel,
} from '../data/site';
import PortfolioGallery from '../components/PortfolioGallery.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { provaSocialGoogle } from '../data/google-reviews';
import { idadeRelativa } from '../data/published-reviews';
import { Image } from 'astro:assets';
import lojaFrente from '../assets/loja-verly-realengo.png';
import neighborhoods from '../data/neighborhoods.json';

// As 11 páginas de bairro saem daqui. Antes eram 11 arquivos de ~305 linhas com o
// mesmo esqueleto — e foi por isso que o nav divergiu do index e as âncoras quebraram.
export function getStaticPaths() {
  return neighborhoods.map((n) => ({ params: { slug: n.slug }, props: { n } }));
}

const { n } = Astro.props;
// Só bairros com dados de entrada da loja recebem a composição local. Os demais
// preservam o template; endereço, horário e mapa continuam na fonte única CONTACT.
const entrance = n.storeEntrance;
const nearby = entrance?.nearby.map(slug => neighborhoods.find(bairro => bairro.slug === slug)!);
const google = n.slug === 'realengo' ? provaSocialGoogle(idadeRelativa, new Date()) : null;

// O texto local é copy; o slug canônico vem da taxonomia única de site.ts.
const localServices = n.services.map((label: string) => {
  const service = serviceForLocalLabel(label);
  if (!service) {
    throw new Error(`Serviço local sem taxonomia: "${label}" (${n.slug}).`);
  }
  return { label, service };
});

// FAQPage só entra quando o bairro realmente tem perguntas (hoje só Realengo).
const faqSchema =
  n.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: n.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
---

<Base
  title={n.title}
  description={n.metaDescription}
  canonicalPath={`/${n.slug}`}
  ogTitle={n.ogTitle}
  ogDescription={n.ogDescription}
  keywords={n.keywords ?? undefined}
  robots={n.robots ?? undefined}
  ogImage={n.ogImage ?? undefined}
  pageType="bairro"
  neighborhoodPage={n.name}
  hasForm={true}
  hasServices={true}
  hasDifferentials={true}
  hasTestimonials={Boolean(entrance)}
>
  {faqSchema && (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <section class:list={["hero", { "hero-principal": n.slug === "realengo" }]}>
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <Icon name="map-marker-alt" /> {entrance ? "Loja física em Realengo" : `Atendemos ${n.name} e toda a Zona Oeste`}
        </div>
        {/* palavra-chave primeiro, métrica depois — o index já usa essa fórmula.
            O travessão era um separador que só o olho enxergava: em blocos, a
            métrica ganha o peso visual e o h1 fecha em duas linhas. */}
        <h1 class="hero-h1">
          <span class="hero-h1-lead">{n.h1}</span>
          <span class="hero-h1-metric">Orçamento em até 2 horas úteis</span>
        </h1>
        {entrance && <div class="store-location">
          <p class="store-address">A loja fica aqui, na {CONTACT.address.street}</p>
          <p>{CONTACT.hoursDisplay}</p>
          <a href={CONTACT.mapsUrl} target="_blank" rel="noopener noreferrer">Abrir mapa ↗</a>
        </div>}
        {n.heroSubtitle && <p class="hero-subtitle">{n.heroSubtitle}</p>}
        <div class="hero-cta">
          {n.slug !== 'realengo' && (
            <a href="#contato" class="btn btn-success btn-lg">
              <Icon name="clipboard-check" /> Solicitar Orçamento Grátis
            </a>
          )}
          <a href={CONTACT.whatsappDirect} target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg" data-context="hero-whatsapp">
            <Icon name="whatsapp" /> WhatsApp Direto
          </a>
          {n.slug === 'realengo' && (
            <>
              <a href={`tel:${CONTACT.landline}`} class="btn hero-call">
                <Icon name="phone" /> Ligar
              </a>
              <a href="#contato" class="hero-callback">Prefere que a gente ligue? Deixe seu número</a>
            </>
          )}
        </div>
        <div class="trust-badges">
          <div class="trust-badge">
            <div class="trust-badge-icon"><Icon name="clock" /></div>
            <div class="trust-badge-text">Resposta em 2h úteis</div>
          </div>
          <div class="trust-badge">
            <div class="trust-badge-icon"><Icon name="credit-card" /></div>
            <div class="trust-badge-text">Parcelamos em até 12x</div>
          </div>
          <div class="trust-badge">
            <div class="trust-badge-icon"><Icon name="tools" /></div>
            <div class="trust-badge-text">Instalação Profissional</div>
          </div>
          <div class="trust-badge">
            <div class="trust-badge-icon"><Icon name="shield-alt" /></div>
            <div class="trust-badge-text">Garantia de Qualidade</div>
          </div>
          {/* Quinto filho de propósito: .trust-badges > :nth-child(5) tem order:-1, então
              a nota assume a primeira posição sem CSS novo — mesmo arranjo da home.
              Ela nasceu aqui porque estas páginas declaravam aggregateRating sem
              mostrar nota nenhuma na tela. O aggregateRating saiu (ver
              LocalBusinessSchema.astro), e a nota FICA: ela trabalha para o
              visitante, não para o rastreador. */}
          <div class="trust-badge">
            <div class="trust-badge-icon"><Icon name="star" /></div>
            <div class="trust-badge-text">
              <a href={GOOGLE_REVIEWS.profileUrl} target="_blank" rel="noopener noreferrer" data-review-intent="proof" data-review-location="nota-da-pagina-de-bairro">
                {google?.notaExibida ?? GOOGLE_REVIEWS.ratingDisplay}★ no Google
              </a>
            </div>
          </div>
        </div>
      </div>

      <figure class="hero-photo">
        <Image
          src={lojaFrente}
          alt={`Fachada da Verly Vidraçaria em Realengo, que atende ${n.name}`}
          widths={[420, 700, 980]}
          width={980}
          sizes="(max-width: 1024px) 92vw, 460px"
          format="webp"
          quality={80}
          loading="eager"
        />
      </figure>
    </div>
  </section>

  {entrance && google && (
    <>
      <section id="depoimentos" class="section local-reviews" aria-labelledby="local-reviews-title">
        <div class="container">
          <h2 id="local-reviews-title" class="section-title">Quem já chamou a Verly</h2>
          {/* Nota, total e textos vêm da MESMA fonte da home (provaSocialGoogle: perfil
              lido no build, ou o snapshot de site.ts). Uma nota própria desta página
              faria a /realengo e a home mostrarem números diferentes. */}
          <p class="section-subtitle">{google.notaExibida}★ · {google.total} avaliações no Google</p>
          <div class="local-reviews-grid">
            {google.depoimentos.slice(0, 2).map(review => (
              <figure class="local-review">
                <div class="testimonial-stars" aria-label={`${review.nota} de 5 estrelas`}>{'★'.repeat(review.nota)}</div>
                <blockquote><p>{review.texto}</p></blockquote>
                <figcaption><strong>{review.autor}</strong><br />Google · {review.quando}</figcaption>
              </figure>
            ))}
          </div>
          <a class="local-review-source" href={GOOGLE_REVIEWS.profileUrl} target="_blank" rel="noopener noreferrer" data-review-intent="proof" data-review-location="depoimentos-realengo">Ver avaliações no perfil do Google ↗</a>
        </div>
      </section>
      <PortfolioGallery />
    </>
  )}

  {/* id local: o nav ancorava "Serviços" em /index.html#servicos mesmo aqui, onde a
      seção existe — 3 dos 4 itens do menu levavam o visitante embora da página de
      bairro em que ele acabou de chegar por busca local. */}
  <section id="servicos" class:list={["section", { "local-services": entrance }]}>
    <div class="container">
      <h2 class="section-title">{n.sectionTitle}</h2>
      {!entrance && n.intro.map((p) => <p class="section-subtitle">{p}</p>)}
      {nearby && <p class="section-subtitle">Atendemos também {nearby.map((bairro, index) => <>{index > 0 && (index === nearby.length - 1 ? ' e ' : ', ')}<a href={`/${bairro.slug}`}>{bairro.name}</a></>)}.</p>}

      <div class="services-grid">
        {localServices.map(({ label, service }) => (
          <div class="service-card" data-service={service.slug} data-whatsapp-message={service.whatsappMessage}>
            <div class="service-icon"><Icon name="check" /></div>
            <h3>{label}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuoteForm
    neighborhood={n.name}
    title={`Orçamento Grátis em ${n.name}`}
    subtitle="Preencha e entraremos em contato em até 2 horas úteis. Sem compromisso."
  />

  <section id="diferenciais" class="section why-choose">
    <div class="container">
      <h2 class="section-title">Por que escolher a Verly em {n.name}?</h2>
      <div class="services-grid">
        {n.reasons.map((r) => (
          <div class="service-card">
            <div class="service-icon"><Icon name="star" /></div>
            <h3>{r}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  {n.faq.length > 0 && (
    <section id="faq" class="section">
      <div class="container">
        <h2 class="section-title">Perguntas Frequentes sobre Vidraçaria em {n.name}</h2>
        {/* <details> nativo: o accordion antigo dependia de jQuery + Bootstrap, que saíram */}
        {n.faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}
  {entrance && (
    <section class="section local-history">
      <div class="container">
        <details class="faq-item">
          <summary>Saiba mais sobre nosso atendimento em {n.name}</summary>
          {n.intro.map(p => <p>{p}</p>)}
        </details>
      </div>
    </section>
  )}
</Base>

<style>
  .store-location { grid-column: 1 / -1; margin: 0 0 20px; line-height: 1.6; }
  .store-location p { margin: 0 0 8px; }
  .store-address { font-size: 1.15rem; font-weight: 600; }
  .store-location a { display: inline-flex; align-items: center; min-height: 44px; color: white; text-decoration: underline; }
  .local-reviews { background: #f5f7f8; }
  .local-reviews-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .local-review { margin: 0; padding: 24px; border: 1px solid #d5dfe2; border-radius: 12px; background: white; color: #173e4a; }
  .local-review blockquote { margin: 12px 0 20px; line-height: 1.7; }
  .local-review figcaption { color: #485b62; line-height: 1.6; }
  .local-review-source { display: inline-flex; align-items: center; min-height: 44px; margin-top: 20px; color: #173e4a; text-decoration: underline; }
  .local-services .section-subtitle a { display: inline-flex; align-items: center; min-height: 44px; }
  .local-services .services-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .local-services .service-card { display: flex; align-items: center; gap: 12px; padding: 20px; text-align: left; }
  .local-services .service-icon { flex-shrink: 0; width: 32px; height: 32px; margin: 0; font-size: 1rem; }
  .local-services .service-card h3 { margin: 0; font-size: 1rem; }
  .local-history { padding-top: 0; }
  .local-history summary { min-height: 44px; }
  @media (max-width: 767px) {
    .local-reviews-grid { grid-template-columns: minmax(0, 1fr); }
    .local-services .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .local-services .service-card { display: block; padding: 16px; }
    .local-services .service-icon { margin-bottom: 12px; }
  }
</style>
