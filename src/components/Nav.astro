---
// Uma única cópia do nav. Antes eram 13 arquivos com o mesmo markup, e foi assim
// que as âncoras quebraram: o index renomeou as seções e as cópias não seguiram.
// Aqui o destino é calculado, então não tem como divergir.
interface Props {
  /** true na home (âncoras na própria página); false nas demais (saltam para o index) */
  home?: boolean;
  /** true quando a página tem o formulário — então #contato é local, não salta */
  hasForm?: boolean;
}
const { home = false, hasForm = false } = Astro.props;
const base = home ? '' : '/index.html';
const contactBase = home || hasForm ? '' : '/index.html';

const links = [
  { href: `${base}#servicos`, label: 'Serviços' },
  { href: `${base}#diferenciais`, label: 'Diferenciais' },
  { href: `${base}#depoimentos`, label: 'Depoimentos' },
  { href: `${contactBase}#contato`, label: 'Contato' },
];
const quoteHref = `${contactBase}#contato`;
---

<nav class="navbar">
  <a href={home ? '#' : '/index.html'} class="logo">
    <i class="fas fa-gem"></i> Verly Vidraçaria
  </a>
  <ul class="nav-menu">
    {links.map((l) => (
      <li><a href={l.href} class="nav-link">{l.label}</a></li>
    ))}
    <li>
      <a href={quoteHref} class="btn btn-primary" style="padding: 10px 20px; font-size: 0.938rem;">
        Orçamento Grátis
      </a>
    </li>
  </ul>
  <button class="mobile-menu-btn" aria-label="Abrir menu">
    <i class="fas fa-bars"></i>
  </button>
</nav>
