---
import Base from '../layouts/Base.astro';
---

<Base
  title={'Vidraçaria Zona Oeste RJ | Orçamento em 2h | Box, Sacadas e Mais | Verly'}
  description={'Verly Vidraçaria - Especialista em vidros temperados, box blindex, cortinas de vidro e soluções em alumínio na Zona Oeste do Rio de Janeiro. Orçamento em até 2 horas!'}
  keywords={'vidraçaria zona oeste, vidros temperados, box blindex, cortina de vidro, vidros Rio de Janeiro, Barra da Tijuca, Recreio, Jacarepaguá'}
  canonicalPath="/"
  ogTitle={'Verly Vidraçaria | Vidros Temperados e Box Blindex na Zona Oeste RJ'}
  ogDescription={'Especialista em vidros temperados, box blindex, cortinas de vidro e soluções em alumínio na Zona Oeste do Rio de Janeiro.'}
  ogUrl="https://verlyvidracaria.com"
  home={true}
>


    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-badge">
                    <i class="fas fa-map-marker-alt"></i> Atendemos toda Zona Oeste RJ
                </div>
                <h1>Vidraçaria na Zona Oeste<br>Orçamento em até 2 Horas</h1>
                <p class="hero-subtitle">
                    Especialistas em Box para Banheiro, Sacadas Envidraçadas, Guarda-corpos e mais. 
                    Atendimento rápido, qualidade garantida e instalação profissional.
                </p>
                <div class="hero-cta">
                    <a href="#contato" class="btn btn-success btn-lg">
                        <i class="fas fa-clipboard-check"></i> Solicitar Orçamento Grátis
                    </a>
                    <a href="https://wa.me/5521987926578?text=Ol%C3%A1%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento!" target="_blank" class="btn btn-secondary btn-lg">
                        <i class="fab fa-whatsapp"></i> WhatsApp Direto
                    </a>
                </div>
                <div class="trust-badges">
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><i class="fas fa-clock"></i></div>
                        <div class="trust-badge-text">Resposta em 2h</div>
                    </div>
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><i class="fas fa-tools"></i></div>
                        <div class="trust-badge-text">Instalação Profissional</div>
                    </div>
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><i class="fas fa-shield-alt"></i></div>
                        <div class="trust-badge-text">Garantia de Qualidade</div>
                    </div>
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><i class="fas fa-star"></i></div>
                        <div class="trust-badge-text">4.8★ (127 avaliações)</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="servicos" class="section">
        <div class="container">
            <h2 class="section-title">Nossos Serviços</h2>
            <p class="section-subtitle">
                Soluções completas em vidros temperados e alumínio para seu projeto
            </p>
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-bath"></i>
                    </div>
                    <h3>Box para Banheiro</h3>
                    <p>Box blindex com vidro temperado 8mm, acabamento premium e instalação rápida.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-building"></i>
                    </div>
                    <h3>Sacadas Envidraçadas</h3>
                    <p>Cortinas de vidro retráteis para sacadas e varandas com alta resistência.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3>Guarda-corpos de Vidro</h3>
                    <p>Guarda-corpos modernos em vidro temperado para escadas e sacadas.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-door-open"></i>
                    </div>
                    <h3>Portas e Janelas</h3>
                    <p>Portas e janelas de vidro temperado e alumínio sob medida.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </div>
                    <h3>Espelhos Sob Medida</h3>
                    <p>Espelhos com e sem moldura, instalação completa e acabamento perfeito.</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <i class="fas fa-th-large"></i>
                    </div>
                    <h3>Divisórias de Ambiente</h3>
                    <p>Divisórias em vidro temperado para ambientes modernos e integrados.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section id="diferenciais" class="section why-choose">
        <div class="container">
            <h2 class="section-title">Por Que Escolher a Verly?</h2>
            <p class="section-subtitle">
                Somos referência em vidraçaria na Zona Oeste do Rio de Janeiro
            </p>
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <div class="feature-content">
                        <h4>Atendimento Local Rápido</h4>
                        <p>Estamos na Zona Oeste. Orçamento em até 2 horas e atendimento no mesmo dia quando possível.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="feature-content">
                        <h4>Equipe Especializada</h4>
                        <p>Profissionais experientes e certificados para instalações seguras e de qualidade.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-certificate"></i>
                    </div>
                    <div class="feature-content">
                        <h4>Garantia Total</h4>
                        <p>Todos os nossos serviços possuem garantia. Trabalhamos apenas com materiais de primeira.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="feature-content">
                        <h4>Orçamento Gratuito</h4>
                        <p>Fazemos orçamento sem compromisso. Medição e consultoria incluídas.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <div class="feature-content">
                        <h4>Cobertura Completa</h4>
                        <p>Atendemos Barra, Recreio, Jacarepaguá, Campo Grande, Realengo e toda Zona Oeste.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-crown"></i>
                    </div>
                    <div class="feature-content">
                        <h4>Materiais Premium</h4>
                        <p>Vidros temperados de alta qualidade e perfis de alumínio com acabamento superior.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials -->
    <section id="depoimentos" class="section">
        <div class="container">
            <h2 class="section-title">O Que Nossos Clientes Dizem</h2>
            <p class="section-subtitle">
                Mais de 127 projetos realizados na Zona Oeste com excelência
            </p>
            <div class="testimonials-grid">
                <div class="testimonial-card">
                    <div class="testimonial-quote">"</div>
                    <div class="testimonial-content">
                        <p class="testimonial-text">
                            Instalaram o box do meu banheiro em menos de 3 horas. Ficou perfeito! 
                            Equipe profissional e atenciosa. Super recomendo!
                        </p>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">MC</div>
                            <div class="testimonial-info">
                                <h5>Mariana Costa</h5>
                                <p>Barra da Tijuca</p>
                                <div class="testimonial-stars">★★★★★</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="testimonial-quote">"</div>
                    <div class="testimonial-content">
                        <p class="testimonial-text">
                            Excelente custo-benefício! Fizeram a sacada de vidro do meu apartamento 
                            com qualidade e no prazo combinado. Muito satisfeito!
                        </p>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">RS</div>
                            <div class="testimonial-info">
                                <h5>Ricardo Santos</h5>
                                <p>Recreio dos Bandeirantes</p>
                                <div class="testimonial-stars">★★★★★</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="testimonial-card">
                    <div class="testimonial-quote">"</div>
                    <div class="testimonial-content">
                        <p class="testimonial-text">
                            Atendimento rápido e orçamento justo. Instalaram espelhos na minha loja 
                            e ficou lindo. Já indiquei para vários amigos!
                        </p>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">PL</div>
                            <div class="testimonial-info">
                                <h5>Paula Lima</h5>
                                <p>Jacarepaguá</p>
                                <div class="testimonial-stars">★★★★★</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Form Section -->
    <section id="contato" class="section contact-section">
        <div class="container">
            <h2 class="section-title">Solicite Seu Orçamento Gratuito</h2>
            <p class="section-subtitle">
                Preencha o formulário e entraremos em contato em até 2 horas úteis
            </p>
            <div class="contact-wrapper">
                <!-- Contact Info -->
                <div class="contact-info">
                    <h3>Informações de Contato</h3>
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <div class="contact-item-content">
                            <strong>WhatsApp</strong>
                            <p>(21) 98792-6578</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="contact-item-content">
                            <strong>Telefone</strong>
                            <p>(21) 98792-6578</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="contact-item-content">
                            <strong>Horário de Atendimento</strong>
                            <p>Segunda a Sábado: 8h às 18h</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="contact-item-content">
                            <strong>Área de Atendimento</strong>
                            <p>Toda Zona Oeste do Rio de Janeiro</p>
                            <p style="font-size: 0.875rem; margin-top: 0.5rem; opacity: 0.9;">
                                Barra da Tijuca, Recreio, Jacarepaguá, Campo Grande, 
                                Realengo, Vargem Grande, Pechincha e região
                            </p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-item-icon">
                            <i class="fas fa-award"></i>
                        </div>
                        <div class="contact-item-content">
                            <strong>Garantia de Qualidade</strong>
                            <p>Mais de 127 projetos realizados com sucesso</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form">
                    <div id="formAlert"></div>
                    <form id="contactForm" novalidate>
                        <div class="form-group">
                            <label class="form-label" for="name">
                                Nome Completo <span class="required">*</span>
                            </label>
                            <input 
                                type="text" 
                                id="name" 
                                name="name"
                                class="form-control" 
                                placeholder="Digite seu nome completo"
                                required
                                autocomplete="name"
                            >
                            <div class="form-error" id="nameError"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="phone">
                                Telefone/WhatsApp <span class="required">*</span>
                            </label>
                            <input 
                                type="tel" 
                                id="phone" 
                                name="phone"
                                class="form-control" 
                                placeholder="(21) 9XXXX-XXXX"
                                required
                                autocomplete="tel"
                            >
                            <div class="form-error" id="phoneError"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="email">
                                E-mail
                            </label>
                            <input 
                                type="email" 
                                id="email" 
                                name="email"
                                class="form-control" 
                                placeholder="seu@email.com"
                                autocomplete="email"
                            >
                            <div class="form-error" id="emailError"></div>
                            <div class="form-help">Opcional, mas nos ajuda a enviar o orçamento</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="neighborhood">
                                Seu Bairro <span class="required">*</span>
                            </label>
                            <select 
                                id="neighborhood" 
                                name="neighborhood"
                                class="form-control"
                                required
                            >
                                <option value="">Selecione seu bairro</option>
                                <option value="Barra da Tijuca">Barra da Tijuca</option>
                                <option value="Recreio dos Bandeirantes">Recreio dos Bandeirantes</option>
                                <option value="Jacarepaguá">Jacarepaguá</option>
                                <option value="Freguesia de Jacarepaguá">Freguesia de Jacarepaguá</option>
                                <option value="Vargem Grande">Vargem Grande</option>
                                <option value="Vargem Pequena">Vargem Pequena</option>
                                <option value="Campo Grande">Campo Grande</option>
                                <option value="Realengo">Realengo</option>
                                <option value="Pechincha">Pechincha</option>
                                <option value="Anil">Anil</option>
                                <option value="Gardênia Azul">Gardênia Azul</option>
                                <option value="Taquara">Taquara</option>
                                <option value="Tanque">Tanque</option>
                                <option value="Praça Seca">Praça Seca</option>
                                <option value="Bangu">Bangu</option>
                                <option value="Outro">Outro bairro da Zona Oeste</option>
                            </select>
                            <div class="form-error" id="neighborhoodError"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Serviços de Interesse <span class="required">*</span>
                            </label>
                            <div class="checkbox-group">
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service1" name="services" value="Box para Banheiro">
                                    <label for="service1">Box para Banheiro</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service2" name="services" value="Sacada Envidraçada">
                                    <label for="service2">Sacada Envidraçada</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service3" name="services" value="Guarda-corpo">
                                    <label for="service3">Guarda-corpo</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service4" name="services" value="Portas de Vidro">
                                    <label for="service4">Portas de Vidro</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service5" name="services" value="Janelas de Alumínio">
                                    <label for="service5">Janelas de Alumínio</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service6" name="services" value="Espelhos">
                                    <label for="service6">Espelhos</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service7" name="services" value="Divisórias">
                                    <label for="service7">Divisórias</label>
                                </div>
                                <div class="checkbox-item">
                                    <input type="checkbox" id="service8" name="services" value="Tampos de Mesa">
                                    <label for="service8">Tampos de Mesa</label>
                                </div>
                            </div>
                            <div class="form-error" id="servicesError"></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="message">
                                Descreva Seu Projeto (Opcional)
                            </label>
                            <textarea 
                                id="message" 
                                name="message"
                                class="form-control" 
                                rows="4"
                                placeholder="Ex: Preciso de um box de 1,20m x 1,80m para banheiro. Gostaria de receber orçamento."
                            ></textarea>
                            <div class="form-help">Quanto mais detalhes, melhor será nosso orçamento</div>
                        </div>

                        <button type="submit" class="btn btn-primary" id="submitBtn" style="width: 100%;">
                            <span id="btnText">
                                <i class="fas fa-paper-plane"></i> Solicitar Orçamento Grátis
                            </span>
                        </button>

                        <p style="text-align: center; margin-top: 1rem; font-size: 0.875rem; color: var(--gray);">
                            <i class="fas fa-clock"></i> Responderemos em até 2 horas úteis
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
</Base>
