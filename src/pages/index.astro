---
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import lojaFrente from '../assets/loja-verly-realengo.png';
import QuoteForm from '../components/QuoteForm.astro';
import ServicesSection from '../components/ServicesSection.astro';
import { CONTACT, GOOGLE_REVIEWS, SERVICE_TAXONOMY } from '../data/site';
import { fetchPublishedReviews, idadeRelativa } from '../data/published-reviews';
import { provaSocialGoogle } from '../data/google-reviews';

// Lidas no build. Devolve [] em qualquer falha, de propósito: o deploy da LP não pode
// depender do Orange Pi estar no ar. Ver o comentário longo em published-reviews.ts.
const verlyReviews = await fetchPublishedReviews();
// A data do build ancora os "há N semanas" das avaliações da Verly, e também as do
// snapshot do Google quando a leitura do perfil falha. Uma página estática não tem "agora".
const geradoEm = new Date();

// Nota e depoimentos do Google. Vem do perfil lido no build quando o raspador rodou, e do
// snapshot manual quando não — `origem` diz qual, e a tela mostra a data, para leitura
// parada aparecer como data velha em vez de sumir sem ninguém ver.
const google = provaSocialGoogle(idadeRelativa, geradoEm);
const lidasEm =
  google.origem === 'perfil'
    ? new Date(google.lidoEm).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' })
    : google.lidoEm;

// Iniciais do avatar DERIVADAS do nome do autor. Antes eram três strings digitadas à
// mão ao lado de três nomes inventados; com nomes reais, digitar de novo só cria uma
// segunda fonte de verdade para alguém desencontrar depois.
const initials = (name: string): string =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join('');
---

<Base
  title={'Vidraçaria Zona Oeste RJ | Orçamento em 2h | Box, Sacadas e Mais | Verly'}
  description={'Verly Vidraçaria - Especialista em vidros temperados, box blindex, cortinas de vidro e soluções em alumínio na Zona Oeste do Rio de Janeiro. Orçamento em até 2 horas!'}
  keywords={'vidraçaria zona oeste, vidros temperados, box blindex, cortina de vidro, vidros Rio de Janeiro, Barra da Tijuca, Recreio, Jacarepaguá'}
  canonicalPath="/"
  ogTitle={'Verly Vidraçaria | Vidros Temperados e Box Blindex na Zona Oeste RJ'}
  ogDescription={'Especialista em vidros temperados, box blindex, cortinas de vidro e soluções em alumínio na Zona Oeste do Rio de Janeiro.'}
  ogUrl="https://verlyvidracaria.com"
  pageType="home"
  home={true}
  hasForm={true}
>


    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-grid">
            <div class="hero-content">
                <div class="hero-badge">
                    <Icon name="map-marker-alt" /> Atendemos toda Zona Oeste RJ
                </div>
                {/* Promessa e métrica em blocos separados, não um <br> no meio de uma
                    linha de 3.5rem: naquele tamanho "Vidraçaria na Zona Oeste" já
                    quebrava sozinha e o <br> somava a QUARTA linha. As páginas de
                    bairro usam a mesma estrutura. */}
                <h1 class="hero-h1">
                    <span class="hero-h1-lead">Vidraçaria na Zona Oeste</span>
                    <span class="hero-h1-metric">Orçamento em até 2 Horas</span>
                </h1>
                <p class="hero-subtitle">
                    Especialistas em Box para Banheiro, Sacadas Envidraçadas, Guarda-corpos e mais. 
                    Atendimento rápido, qualidade garantida e instalação profissional.
                </p>
                <div class="hero-cta">
                    <a href="#contato" class="btn btn-success btn-lg">
                        <Icon name="clipboard-check" /> Solicitar Orçamento Grátis
                    </a>
                    {/* data-context nomeia a origem do clique no whatsapp_click. Sem ele o
                        evento saía como context="unknown", e este é o CTA mais exposto da
                        página. O mesmo valor vale no hero das páginas de bairro: quem separa
                        home de bairro agora é o page_type. */}
                    <a href="https://wa.me/5521987926578?text=Ol%C3%A1%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento!" target="_blank" class="btn btn-whatsapp btn-lg" data-context="hero-whatsapp">
                        <Icon name="whatsapp" /> WhatsApp Direto
                    </a>
                </div>
                <div class="trust-badges">
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><Icon name="clock" /></div>
                        <div class="trust-badge-text">Resposta em 2h</div>
                    </div>
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><Icon name="credit-card" /></div>
                        <div class="trust-badge-text">Parcelamos em até 12x</div>
                    </div>
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><Icon name="tools" /></div>
                        <div class="trust-badge-text">Instalação Profissional</div>
                    </div>
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><Icon name="shield-alt" /></div>
                        <div class="trust-badge-text">Garantia de Qualidade</div>
                    </div>
                    <div class="trust-badge">
                        <div class="trust-badge-icon"><Icon name="star" /></div>
                        {/* Nota sem contagem, e com a fonte clicável: a diferença entre uma
                            estrela que o visitante acredita e uma que ele confere é o link. O
                            link só ajuda se a nota BATER com o perfil — foi ele que denunciou o
                            5,0 que ficou cinco semanas no ar. A contagem (19) não vai para a
                            tela e não vai mais para schema nenhum — ver GOOGLE_REVIEWS. */}
                        <div class="trust-badge-text">
                            <a href={GOOGLE_REVIEWS.profileUrl} target="_blank" rel="noopener noreferrer">
                                {google.notaExibida}★ no Google
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Foto de INSTALAÇÃO no hero, não a fachada. Quem chega aqui vem de
                 "box em <bairro>" na busca orgânica (79 das 126 sessões) e quer ver o
                 serviço, não a porta da loja. Box é o serviço que o H1 e o subtítulo
                 nomeiam primeiro, é a busca que mais traz gente e é a foto mais legível
                 das cinco: frontal, iluminada e reconhecível em um piscar — as outras
                 quatro são recorte de detalhe (guarda-corpo), ambiente específico
                 (espelho em hall), vista que domina o assunto (sacada) ou lêem como
                 divisória (portas e janelas).
                 A fachada não foi descartada: passou para "Por Que Escolher a Verly?",
                 onde faz o trabalho que realmente é dela — provar endereço e loja
                 física.
                 Fora de astro:assets porque o arquivo mora em public/ e já é .webp;
                 eager + fetchpriority porque está acima da dobra e é candidata a LCP. -->
            <figure class="hero-photo">
                <img
                    src="/img/servicos/box-banheiro.webp"
                    alt="Box de banheiro em vidro temperado com perfil e puxador pretos, instalado pela Verly"
                    width="800"
                    height="600"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </figure>
            </div>
        </div>
    </section>

    <ServicesSection />

    <!-- Testimonials. Subiu de 6ª para 4ª seção: estava atrás de serviços, galeria,
         faixa de CTA e diferenciais (a galeria não existe mais como seção — fundiu
         com os serviços), e a visita média é de 28 SEGUNDOS com 96% de
         visitantes novos — ou seja, a prova social praticamente não era lida por quem
         ainda não conhece a loja e é exatamente quem precisa dela. NN/g, "F-Shaped
         Pattern for Reading Web Content" (Nielsen, 2006, eye-tracking com 232
         usuários): a atenção se concentra no topo e decai com a rolagem.

         Fica ANTES da faixa de CTA, não depois. Prova social é o gatilho da decisão
         (Cialdini, "Influence", 1984), então tem de chegar antes do pedido, não como
         justificação a posteriori. A ordem agora é reconhecimento + prova visual na
         MESMA seção (serviços com foto) → prova de terceiros (depoimentos) → razões
         para escolher a loja, com a foto da fachada → pedido (faixa de CTA), com o
         bloco de prova inteiro alimentando o primeiro CTA do meio da página.

         Não sobe para logo depois do hero de propósito: acima dos serviços o
         visitante ainda não sabe o que a loja vende, os depoimentos citam serviços
         que ele não viu, e empurrar a lista de serviços para baixo enterraria
         justamente o que ele buscou. -->
    <section id="depoimentos" class="section">
        <div class="container">
            <h2 class="section-title">O Que Nossos Clientes Dizem</h2>
            {/* Os três cartões eram texto de escritório assinado por gente que não existe.
                Agora saem do perfil da loja no Google, lido no build, com o snapshot manual de
                GOOGLE_REVIEWS.featured como reserva — copiadas na íntegra nos dois casos. O subtítulo trocou "mais de 127 projetos" pela procedência: ali o
                127 era a contagem falsa de avaliações reaproveitada como contagem de obras. O
                que o visitante pode conferir não é quantos, é onde as falas estão publicadas.
                A data de leitura continua visível porque a NOTA é snapshot; os "há N semanas"
                não dependem mais dela, cada cartão carrega o próprio `publishedAt`. */}
            {/* O subtítulo é condicional porque a procedência mudou de uma fonte para
                duas. Enquanto só houver as do Google, ele afirma exatamente o que
                afirmava; com avaliações vindas do link, dizer "publicadas no perfil do
                Google" passaria a ser falso para parte dos cartões da mesma grade.

                A data é a do dado que REALMENTE está na página: lida do perfil neste
                build, ou a do snapshot manual se a leitura falhou. Afirmar a data errada
                aqui seria o mesmo defeito que o "há 1 semana" de cinco semanas. */}
            <p class="section-subtitle">
                {verlyReviews.length > 0 ? (
                    <>
                        Avaliações de clientes atendidos pela loja, enviadas por eles e
                        reproduzidas na íntegra. As do Google vêm
                        <a href={GOOGLE_REVIEWS.profileUrl} target="_blank" rel="noopener noreferrer">do perfil da loja</a>,
                        como estavam em {lidasEm}
                    </>
                ) : (
                    <>
                        Avaliações publicadas por clientes
                        <a href={GOOGLE_REVIEWS.profileUrl} target="_blank" rel="noopener noreferrer">no perfil do Google da loja</a>,
                        reproduzidas aqui na íntegra — como estavam em {lidasEm}
                    </>
                )}
            </p>
            {/* As da Verly vêm primeiro: são as únicas que podem trazer FOTO do serviço
                instalado, e foto do resultado é o que a página inteira não tem para
                mostrar. Ficam na mesma grade para não sugerir duas categorias de
                cliente. */}
            <div class="testimonials-grid">
                {verlyReviews.map((review) => (
                <div class="testimonial-card">
                    <div class="testimonial-quote">"</div>
                    <div class="testimonial-content">
                        <p class="testimonial-text">{review.comment}</p>
                        {review.photoUrls.length > 0 && (
                            <ul class="testimonial-photos">
                                {review.photoUrls.map((url) => (
                                    <li>
                                        {/* Não passa por astro:assets: o arquivo mora no
                                            Garage e não na árvore do repo, então não há
                                            o que otimizar em tempo de build. `loading`
                                            e `decoding` porque a seção fica abaixo da
                                            dobra, e aspect-ratio no CSS porque as
                                            dimensões só o arquivo conhece — sem ela, a
                                            imagem empurraria o texto ao carregar. */}
                                        <img src={url} alt={`Serviço realizado pela Verly${review.serviceType ? ` — ${review.serviceType}` : ''}`} loading="lazy" decoding="async" />
                                    </li>
                                ))}
                            </ul>
                        )}
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">{initials(review.customerName ?? 'Cliente')}</div>
                            <div class="testimonial-info">
                                <h3>{review.customerName ?? 'Cliente Verly'}</h3>
                                <p>{[idadeRelativa(review.publishedAt, geradoEm), review.serviceType].filter(Boolean).join(' · ')}</p>
                                <div class="testimonial-stars">{'★'.repeat(review.rating)}</div>
                            </div>
                        </div>
                    </div>
                </div>
                ))}
                {google.depoimentos.map((review) => (
                <div class="testimonial-card">
                    <div class="testimonial-quote">"</div>
                    <div class="testimonial-content">
                        <p class="testimonial-text">{review.texto}</p>
                        {review.fotos.length > 0 && (
                            <ul class="testimonial-photos">
                                {review.fotos.map((url) => (
                                    <li>
                                        {/* Hospedada pelo Google, exibida daqui — a política
                                            manda mostrar a foto do autor junto da avaliação, e
                                            baixá-la para o nosso storage seria guardar conteúdo
                                            de terceiro. Fora de astro:assets pelo mesmo motivo
                                            das fotos do Garage: o arquivo não está no repo. */}
                                        <img src={url} alt={`Foto enviada por ${review.autor} na avaliação do Google`} loading="lazy" decoding="async" referrerpolicy="no-referrer-when-downgrade" />
                                    </li>
                                ))}
                            </ul>
                        )}
                        <div class="testimonial-author">
                            {/* Avatar do perfil quando o Google entrega; iniciais quando não.
                                "Attribute the author using all available resources (avatar,
                                name, and profile link)" — a foto do autor é parte da
                                atribuição obrigatória, não enfeite. */}
                            {review.avatar ? (
                                <img class="testimonial-avatar" src={review.avatar} alt={`Foto de perfil de ${review.autor}`} loading="lazy" decoding="async" width="48" height="48" />
                            ) : (
                                <div class="testimonial-avatar">{initials(review.autor)}</div>
                            )}
                            <div class="testimonial-info">
                                <h3>
                                    {review.perfilAutor ? (
                                        <a href={review.perfilAutor} target="_blank" rel="noopener noreferrer nofollow">{review.autor}</a>
                                    ) : (
                                        review.autor
                                    )}
                                </h3>
                                <p>{review.quando}</p>
                                {/* Estrela por NOTA, não cravada: o perfil tem 1x3 e 1x1
                                    estrela, e no dia em que uma delas entrar nesta lista o
                                    cartão não pode desenhar cinco. */}
                                <div class="testimonial-stars">{'★'.repeat(review.nota)}</div>
                            </div>
                        </div>
                    </div>
                </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section id="diferenciais" class="section why-choose">
        <div class="container">
            <h2 class="section-title">Por Que Escolher a Verly?</h2>
            <p class="section-subtitle">
                Somos referência em vidraçaria na Zona Oeste do Rio de Janeiro
            </p>
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon">
                        <Icon name="rocket" />
                    </div>
                    <div class="feature-content">
                        <h3>Atendimento Local Rápido</h3>
                        <p>Estamos na Zona Oeste. Orçamento em até 2 horas e atendimento no mesmo dia quando possível.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <Icon name="user-tie" />
                    </div>
                    <div class="feature-content">
                        <h3>Equipe Especializada</h3>
                        <p>Profissionais experientes e certificados para instalações seguras e de qualidade.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <Icon name="certificate" />
                    </div>
                    <div class="feature-content">
                        <h3>Garantia Total</h3>
                        <p>Todos os nossos serviços possuem garantia. Trabalhamos apenas com materiais de primeira.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <Icon name="dollar-sign" />
                    </div>
                    <div class="feature-content">
                        <h3>Orçamento Gratuito</h3>
                        <p>Fazemos orçamento sem compromisso. Medição e consultoria incluídas.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <Icon name="map-marked-alt" />
                    </div>
                    <div class="feature-content">
                        <h3>Cobertura Completa</h3>
                        <p>Atendemos Barra, Recreio, Jacarepaguá, Campo Grande, Realengo e toda Zona Oeste.</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">
                        <Icon name="crown" />
                    </div>
                    <div class="feature-content">
                        <h3>Materiais Premium</h3>
                        <p>Vidros temperados de alta qualidade e perfis de alumínio com acabamento superior.</p>
                    </div>
                </div>
            </div>

            <!-- A fachada saiu do hero e veio para cá. No hero ela ocupava o lugar da
                 prova de serviço para quem buscou um serviço; aqui ela faz o que
                 realmente sabe fazer, que é sustentar as razões desta seção: existe
                 endereço, existe loja de rua, existe para onde ir reclamar. É o mesmo
                 arquivo do repo, então continua passando por astro:assets — o que muda
                 é a posição e o `loading`, que virou lazy porque agora está bem abaixo
                 da dobra e não é mais candidata a LCP. -->
            <figure class="why-choose-photo">
                <Image
                    src={lojaFrente}
                    alt="Fachada da Verly Vidraçaria na Rua General Azeredo, 218 - Loja C, em Realengo"
                    widths={[420, 700, 980]}
                    width={980}
                    sizes="(max-width: 768px) 92vw, 400px"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                />
                {/* Endereço e horário saem de CONTACT, a mesma fonte do rodapé e do
                    LocalBusiness: uma legenda digitada à mão seria a quarta grafia do
                    mesmo endereço, e a primeira a desencontrar quando a loja mudar. */}
                <figcaption>
                    Nossa loja na {CONTACT.address.street}, {CONTACT.address.locality} —
                    atendimento presencial {CONTACT.hoursDisplay}.
                </figcaption>
            </figure>
        </div>
    </section>

    <!-- Ponto de conversão no meio da página, agora fechando o bloco de prova: o
         visitante acabou de ver o serviço instalado (fotos), o que outros clientes
         disseram (depoimentos) e por que a loja (diferenciais + fachada). Continua
         muito acima do formulário, que só aparece depois de ~5.000px de rolagem no
         celular. Faixa com âncora, não um segundo <QuoteForm /> — ver o comentário de
         .cta-band no CSS. -->
    <section class="cta-band">
        <div class="container cta-band-inner">
            <div>
                <h2>Achou o serviço que precisa?</h2>
                <p>Orçamento gratuito, sem compromisso, com resposta em até 2 horas úteis.</p>
            </div>
            <div class="cta-band-actions">
                <a href="#contato" class="btn btn-success">
                    <Icon name="clipboard-check" /> Solicitar Orçamento Grátis
                </a>
                <a href={CONTACT.whatsappDirect} target="_blank" rel="noopener" class="cta-band-alt" data-context="cta-band">
                    ou fale direto no WhatsApp
                </a>
            </div>
        </div>
    </section>


    <QuoteForm />

    <!-- Footer -->
</Base>
