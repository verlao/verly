---
import Icon from '../components/Icon.astro';
import { getImage } from 'astro:assets';
import { SITE_URL, ANALYTICS, CONTACT } from '../data/site';
import lojaFrente from '../assets/loja-verly-realengo.png';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import '../styles/index-inline.css';
import '../styles/ui-improvements.css';
import '../styles/whatsapp-cta.css';

interface Props {
  title: string;
  description: string;
  /** caminho canônico com .html, ex.: '/realengo.html' ou '/' na home */
  canonicalPath: string;
  keywords?: string;
  /** paridade: as páginas de bairro publicam meta robots hoje; a home não */
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** true só na home — decide se as âncoras do nav são locais ou saltam pro index */
  home?: boolean;
  /** a página traz o formulário? decide se o nav aponta #contato local */
  hasForm?: boolean;
  bodyClass?: string;
  /** paridade: blog/obrigado/404/500 não carregam LocalBusiness hoje */
  schema?: boolean;
  /** paridade: realengo.html não tem aggregateRating hoje */
  includeRating?: boolean;
  /** override de og:url — a home hoje publica a URL sem barra final */
  ogUrl?: string;
}

const {
  title,
  description,
  canonicalPath,
  keywords,
  robots,
  ogTitle,
  ogDescription,
  ogImage,
  home = false,
  hasForm = false,
  bodyClass,
  schema = true,
  includeRating = true,
  ogUrl,
} = Astro.props;

const canonical = `${SITE_URL}${canonicalPath}`;

// O thumb de compartilhamento sai da MESMA imagem que a página exibe. Antes era
// `/img/logo.png` fixo: trocar a foto da loja não mudava o preview no WhatsApp, e o
// que aparecia era o logotipo antigo em script fino. Derivando do asset, os dois
// nunca mais divergem.
// JPEG de propósito — suporte a webp em scraper de rede social ainda é irregular.
// A foto é retrato (a fachada, sem corte). Para o thumb social, recorto no
// pipeline com fit/position em vez de manter um segundo arquivo: assim continua
// derivando do MESMO asset, e 'bottom' foca a loja em vez do céu — um recorte
// centrado nesta foto mostraria quase só céu.
const ogFallback = await getImage({
  src: lojaFrente,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 82,
});
const ogImageUrl = ogImage ?? `${SITE_URL}${ogFallback.src}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>

    <!-- Fonte. Antes: 6 pesos estáticos (300..800) + Font Awesome inteiro, os dois
         render-blocking. Agora: a fonte variável cobre 400-800 num arquivo só, e os
         ícones viraram SVG inline (src/components/Icon.astro). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics 4 + Google Ads (carregado verbatim do site atual) -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4}`}></script>
    <script is:inline define:vars={{ ga4: ANALYTICS.ga4, ads: ANALYTICS.googleAds }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', ga4, {
        send_page_view: true,
        cookie_flags: 'SameSite=None;Secure',
      });
      gtag('config', ads);
    </script>

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={ogUrl ?? canonical} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="canonical" href={canonical} />

    {schema && <LocalBusinessSchema includeRating={includeRating} image={ogImageUrl} />}
    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <header class="header">
      <div class="container">
        <Nav home={home} hasForm={hasForm} />
      </div>
    </header>

    <slot />

    <Footer home={home} />

    <!-- Botão flutuante do WhatsApp. Antes só existia na home; agora vale em toda página. -->
    <a
      href={CONTACT.whatsappFloat}
      class="whatsapp-float"
      data-context="floating-button"
      aria-label="Falar no WhatsApp"
    >
      <Icon name="whatsapp" />
    </a>

    <script is:inline src="/js/ui-improvements.js"></script>
    <script is:inline src="/js/whatsapp-cta.js"></script>
    <script is:inline src="/js/app.js"></script>
  </body>
</html>
